{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dislite",
  "version": "../package.json",
  "identifier": "dev.accord.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dislite",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 520,
        "backgroundColor": "#292734"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://*.discordapp.com https://*.discordapp.net https://discord.com; media-src 'self' blob: https://*.discordapp.com https://*.discordapp.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3RjQ1MDA3MzFDNDhGMTgKUldRWWo4UXhCMUQwQitrNVowekV4MDFjNVAyZ3FZbFNuZFVhdVZjN0hsVy9McE9HT0xXMjNwZUgK",
      "endpoints": ["https://github.com/git-psi/Dislite/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "SocialNetworking",
    "publisher": "git-psi",
    "copyright": "© 2026 git-psi, MIT License",
    "homepage": "https://github.com/git-psi/Dislite",
    "shortDescription": "Client Discord minimaliste",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
