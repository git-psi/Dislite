#!/usr/bin/env python3
"""Exécute du JavaScript dans Accord (build de dev) : accord-eval 'return location.href'
Le code est le corps d'une fonction async ; `return` renvoie une valeur JSON."""
import json, os, socket, sys

code = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "accord-debug.sock")
with socket.socket(socket.AF_UNIX) as s:
    s.connect(path)
    s.sendall(code.replace("\n", " ").encode() + b"\n")
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
res = json.loads(buf)
if code.startswith("@snapshot"):
    res.setdefault("value", "ok")
print(json.dumps(res.get("value", res), ensure_ascii=False, indent=1) if res.get("ok") else "ERREUR: " + str(res.get("value") or res.get("error")))
sys.exit(0 if res.get("ok") else 1)
